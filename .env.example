# ============================================================
# BuildGuard-AI environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub.
# ============================================================

# --- App ---
APP_NAME=BuildGuard-AI
APP_ENV=local
APP_PORT=8000
LOG_LEVEL=INFO

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=buildguard-blueprints
S3_BLUEPRINT_PREFIX=blueprints/
S3_SAFETY_MANUAL_PREFIX=safety-manuals/

# --- Amazon RDS (MySQL) ---
RDS_HOST=
RDS_PORT=3306
RDS_DB_NAME=buildguard
RDS_USER=
RDS_PASSWORD=
RDS_POOL_SIZE=5
RDS_MAX_OVERFLOW=10

# --- FAISS ---
FAISS_INDEX_PATH=./vector_db/faiss_index
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Nous Hermes (self-hosted OpenAI-compatible endpoint) ---
NOUS_HERMES_BASE_URL=http://localhost:8080/v1
NOUS_HERMES_API_KEY=local-key
NOUS_HERMES_MODEL_NAME=NousResearch/Hermes-2-Pro-Llama-3-8B
NOUS_HERMES_TEMPERATURE=0.1
NOUS_HERMES_MAX_TOKENS=1500

# --- OpenClaw (warning generation service/model) ---
OPENCLAW_BASE_URL=http://localhost:8081/v1
OPENCLAW_API_KEY=local-key
OPENCLAW_MODEL_NAME=openclaw-warning-gen

# --- Security ---
API_KEY_HEADER_NAME=X-API-KEY
API_KEY_SECRET=change-me-in-production
